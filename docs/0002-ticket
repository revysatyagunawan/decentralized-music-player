### `auth.service.verifySolidIdToken(idToken)`

```js
const { payload } = await jwtVerify(idToken, jwks, {
  issuer: SOLID_OIDC_ISSUER,
  audience: SOLID_OIDC_CLIENT_ID,
  clockTolerance: 30,
});

const webid = payload.webid ?? payload.sub;
if (!webid) throw ApiError(401, 'solid_auth_failed', { reason: 'no_webid' });

const displayName = payload.name ?? defaultDisplayName(webid);
