### `src/lib/pod-writer.ts`

```ts
import {
  saveFileInContainer,
  createContainerAt,
} from '@inrupt/solid-client';
import { getDefaultSession } from '@inrupt/solid-client-authn-browser';

export async function ensureContainer(url: string): Promise<void> {
  try {
    await createContainerAt(url, { fetch: getDefaultSession().fetch });
  } catch (e) {
    // Already exists → ignore
    if ((e as Error).message?.includes('409')) return;
    throw e;
  }
}

export async function uploadFile(
  containerUrl: string,
  fileName: string,
  file: File,
): Promise<string> {
  const fileBlob = new Blob([await file.arrayBuffer()], { type: file.type });
  const saved = await saveFileInContainer(containerUrl, fileBlob, {
    slug: fileName,
    contentType: file.type,
    fetch: getDefaultSession().fetch,
  });
  return saved.internal_resourceInfo.sourceIri;
}

export async function uploadJson(
  containerUrl: string,
  fileName: string,
  data: unknown,
): Promise<string> {
  const blob = new Blob([JSON.stringify(data, null, 2)], {
    type: 'application/ld+json',
  });
  const saved = await saveFileInContainer(containerUrl, blob, {
    slug: fileName,
    contentType: 'application/ld+json',
    fetch: getDefaultSession().fetch,
  });
  return saved.internal_resourceInfo.sourceIri;
}
```

### `src/lib/slug.ts`

```ts
export function slugify(text: string): string {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .slice(0, 60);
}
```

### `src/lib/metadata-builder.ts`

```ts
type TrackInput = {
  title: string;
  artistName: string;
  artistWebId: string;
  genre: string[];
  description?: string;
  audioUrl: string;
  coverUrl?: string;
  durationSeconds: number;
};

export function buildMetadata(input: TrackInput, selfUrl: string) {
  const duration = `PT${Math.floor(input.durationSeconds / 60)}M${input.durationSeconds % 60}S`;
  return {
    '@context': { '@vocab': 'https://schema.org/' },
    '@type': 'MusicRecording',
    '@id': selfUrl,
    name: input.title,
    byArtist: {
      '@id': input.artistWebId,
      '@type': 'Person',
      name: input.artistName,
    },
    contentUrl: input.audioUrl,
    duration,
    ...(input.genre.length > 0 && { genre: input.genre }),
    ...(input.description && { description: input.description }),
    ...(input.coverUrl && { image: input.coverUrl }),
    datePublished: new Date().toISOString().split('T')[0],
  };
}
```

### Upload flow (dipanggil dari `UploadForm.tsx`)

```
1. slug = slugify(title)
2. Determine pod storage URL:
   - Profile Pod URL diambil dari WebID: parse WebID (https://alice.pod/profile/card#me)
   - Extract origin: https://alice.pod
   - Container: `${origin}/music/${slug}/`
3. ensureContainer(containerUrl)
4. uploadFile(containerUrl, 'audio.mp3', audioFile) → audioUrl
5. (opsional) uploadFile(containerUrl, 'cover.jpg', coverFile) → coverUrl
6. metadataUrl = `${containerUrl}metadata.jsonld`
7. metadata = buildMetadata(input, metadataUrl)
8. uploadJson(containerUrl, 'metadata.jsonld', metadata)
9. POST /api/tracks/sync { pod_resource_url: metadataUrl }
10. Return track dari backend
```

### Duration detection

Sebelum upload, di frontend:
```ts
