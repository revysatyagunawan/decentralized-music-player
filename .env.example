# Node
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Postgres
POSTGRES_USER=solidmusic
POSTGRES_PASSWORD=dev-password
POSTGRES_DB=solidmusic
DATABASE_URL=postgres://solidmusic:dev-password@postgres:5432/solidmusic?sslmode=disable

# JWT internal
JWT_SECRET=replace-with-openssl-rand-base64-32
JWT_TTL=24h

# CORS
CORS_ORIGINS=http://localhost:5173

# Multi-issuer DPoP (comma-separated)
ALLOWED_ISSUERS=https://host.docker.internal,https://solidcommunity.net,https://inrupt.net,https://login.inrupt.com,https://pod.inrupt.com

# Dev only: trust self-signed cert from Caddy for Pod fetches
# HAPUS di production
NODE_TLS_REJECT_UNAUTHORIZED=0
